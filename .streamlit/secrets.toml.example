# Copy these into Streamlit Community Cloud: App settings > Secrets. Do not commit real values.
# Top-level secrets become environment variables, which is how the app reads them.

# A hosted PostgreSQL database (Supabase, Neon, Railway...). Required on Streamlit Community Cloud:
# its disk is wiped on every restart, so the default SQLite file would lose your data.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Turn sign-in on. Do this BEFORE anyone else can open the app, then open it yourself first
# and create the administrator account.
RIDEOPS_REQUIRE_LOGIN = "1"

# Optional: token the "Connect an API" form and refresh.py use, and which hosts the server may call.
# RIDEOPS_API_TOKEN = "..."
# RIDEOPS_API_ALLOWED_HOSTS = "api.example.com"
